# Copia este archivo a `.env` y completa los valores.
# `flutenv run` / `flutenv build apk --release` los inyecta como --dart-define.

# URL del proyecto de Supabase.
SUPABASE_URL=https://<project-ref>.supabase.co

# Clave publicable del proyecto (sb_publishable_... o la anon key legacy).
SUPABASE_ANON_KEY=sb_publishable_...

# Google OAuth - client ID tipo Web. Es el `serverClientId` de `google_sign_in`
# y el `aud` que valida Supabase. Debe estar registrado en
# Supabase > Authentication > Providers > Google.
GOOGLE_SERVER_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
